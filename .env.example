# Port exposed on the Docker host for the static web server.
# Intentionally non-standard — front it with your own reverse proxy, tunnel,
# or port-forwarding layer.
HOST_PORT=8080

# IPv4 address the captive-port DNS will return for `manuals.playstation.net`.
# MUST be the LAN address of the host running docker (so the PS5 reaches the
# web server above). Defaults to 127.0.0.1 which is only useful for in-host tests.
DNS_IP=127.0.0.1

# IPv4 address the DNS container will bind on (host side, UDP/TCP port 53).
# Setting this to your main NIC IP (e.g. 192.168.1.50) keeps the OS resolver
# at 127.0.0.53 untouched and avoids conflicts with systemd-resolved / dnsmasq.
# Get yours with:  hostname -I | awk '{print $1}'
# Leave it at 127.0.0.1 for local-only tests; the PS5 will NOT be able to
# resolve manuals.playstation.net in that case.
DNS_BIND_IP=127.0.0.1