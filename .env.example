# Port exposed on the Docker host for the static web server.
# Intentionally non-standard — front it with your own reverse proxy, tunnel,
# or port-forwarding layer.
HOST_PORT=8080

# IPv4 address the captive-port DNS will return for primary targets (see
# DNS_TARGETS below — defaults to manuals.playstation.net). MUST be the LAN
# address of the host running docker so the PS5 reaches the web server above.
# Defaults to 127.0.0.1 which is only useful for in-host tests.
DNS_IP=127.0.0.1

# Comma-separated list of names that should resolve to DNS_IP (A record).
# This is what the PS5 captive-port probe asks for. Default already includes
# `manuals.playstation.net`. Override only if you know what you're doing.
DNS_TARGETS=manuals.playstation.net

# Comma-separated list of names that should resolve to 0.0.0.0 (A record).
# These are Sony telemetry / sign-in endpoints that the PS5 periodically
# tries to reach. Returning 0.0.0.0 (instead of NXDOMAIN) silently kills the
# connection on the client side and avoids re-triggering the captive-port
# loop. Defaults already cover the two most common ones.
DNS_NULL_TARGETS=smetrics.aem.playstation.com,telemetry-console.api.playstation.com,ps5.np.playstation.net

# IPv4 address the DNS container will bind on (host side, UDP/TCP port 53).
# Setting this to your main NIC IP (e.g. 192.168.1.50) keeps the OS resolver
# at 127.0.0.53 untouched and avoids conflicts with systemd-resolved / dnsmasq.
# Get yours with:  hostname -I | awk '{print $1}'
# Leave it at 127.0.0.1 for local-only tests; the PS5 will NOT be able to
# resolve manuals.playstation.net in that case.
DNS_BIND_IP=127.0.0.1

# DNS query logging
# Every query the DNS receives is logged with client IP:port, queried name
# (original casing), type, class, and whether we answered it.
# Tail live queries with:
#   docker compose logs -f dns
# Or filter to queries only:
#   docker compose logs -f dns 2>&1 | grep 'query '