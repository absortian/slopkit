# Port exposed on the Docker host for the static web server.
# Intentionally non-standard — front it with your own reverse proxy, tunnel,
# or port-forwarding layer.
HOST_PORT=8080

# IPv4 address the captive-port DNS will return for `manuals.playstation.net`.
# MUST be the LAN address of the host running docker (so the PS5 reaches the
# web server above). Defaults to 127.0.0.1 which is only useful for in-host tests.
DNS_IP=127.0.0.1