# Port exposed on the Docker host for the static web server.
# Intentionally non-standard — front it with your own reverse proxy, tunnel,
# or port-forwarding layer.
HOST_PORT=8080

# IPv4 address the captive-port DNS will return for primary targets (see
# DNS_TARGETS below — defaults to manuals.playstation.net). MUST be the LAN
# address of the host running docker so the PS5 reaches the web server above.
# Defaults to 127.0.0.1 which is only useful for in-host tests.
DNS_IP=127.0.0.1

# Comma-separated list of names that should resolve to DNS_IP (A record).
# This is what the PS5 captive-port probe asks for. Default already includes
# `manuals.playstation.net`. Override only if you know what you're doing.
DNS_TARGETS=manuals.playstation.net

# Comma-separated list of names that should resolve to 0.0.0.0 (A record).
# These are Sony telemetry / sign-in endpoints that the PS5 periodically
# tries to reach. Returning 0.0.0.0 (instead of NXDOMAIN) silently kills the
# connection on the client side and avoids re-triggering the captive-port
# loop. Defaults already cover the two most common ones.
DNS_NULL_TARGETS=smetrics.aem.playstation.com,telemetry-console.api.playstation.com,ps5.np.playstation.net

# Comma-separated list of `alias=reference` pairs. The `alias` is answered
# with the SAME IP as the `reference`. The `reference` MUST already be in
# DNS_TARGETS — we do not perform recursive resolution, so an alias that
# points at a name we don't answer for would just silently fall through to
# NXDOMAIN. The DNS container refuses to start if any alias references a
# name that isn't in DNS_TARGETS, so misconfigurations fail loud at boot
# rather than at captive-port-probe time.
#
# Use case: some consoles / firmwares probe additional captive-port hosts
# beyond `manuals.playstation.net` (e.g. `www.playstation.com`,
# `www.example.com`). Add them here instead of duplicating DNS_IP.
#
# Example: `DNS_ALIAS_TARGETS=www.playstation.com=manuals.playstation.net`
DNS_ALIAS_TARGETS=

# Comma-separated list of `alias=external_domain` pairs. When the alias is
# queried we ask the upstream resolver (DNS_UPSTREAM, default 1.1.1.1:53)
# for an A record of `external_domain` and return that IP. The result is
# cached for the upstream's TTL (clamped to [30s, 1h]) so repeated PS5
# probes don't hammer the resolver. If the upstream lookup fails the alias
# falls back to DNS_IP so the captive-port flow still terminates at the
# local server even when the host has no internet.
#
# Use case: your ISP gives you a dynamic IP and you keep your real public
# address behind a domain (e.g. DuckDNS, No-IP, your own zone). Adding
# `manuals.playstation.net=home.absor.top` lets the captive-port probe
# resolve to whatever IP your domain currently points at — useful if you
# remote into your LAN and want the captive check to follow your public IP.
#
# Example: `DNS_RESOLVE_TARGETS=manuals.playstation.net=home.absor.top`
DNS_RESOLVE_TARGETS=

# Upstream resolver used by DNS_RESOLVE_TARGETS. Must be `host:port` form.
# Defaults to Cloudflare (1.1.1.1:53) which is fast and anycast-reachable
# from most home networks. Set this to your own DNS or a LAN resolver if
# you don't want to depend on a third party.
DNS_UPSTREAM=1.1.1.1:53

# IPv4 address the DNS container will bind on (host side, UDP/TCP port 53).
# Setting this to your main NIC IP (e.g. 192.168.1.50) keeps the OS resolver
# at 127.0.0.53 untouched and avoids conflicts with systemd-resolved / dnsmasq.
# Get yours with:  hostname -I | awk '{print $1}'
# Leave it at 127.0.0.1 for local-only tests; the PS5 will NOT be able to
# resolve manuals.playstation.net in that case.
DNS_BIND_IP=127.0.0.1

# DNS query logging
# Every query the DNS receives is logged with client IP:port, queried name
# (original casing), type, class, and whether we answered it.
# Tail live queries with:
#   docker compose logs -f dns
# Or filter to queries only:
#   docker compose logs -f dns 2>&1 | grep 'query '